      font-size: 16px;
      line-height: 1.7;
      padding: 60px 24px;
    }

    .container {
      max-width: 680px;
      margin: 0 auto;
    }

    .back {
      display: inline-block;
      color: var(--accent);
      text-decoration: none;
      font-size: 14px;
      margin-bottom: 48px;
      opacity: 0.8;
      transition: opacity 0.2s;
    }
    .back:hover { opacity: 1; }

    .site-name {
      font-family: 'Lora', serif;
      font-size: 13px;
      color: var(--accent);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    h1 {
      font-family: 'Lora', serif;
      font-size: 32px;
      font-weight: 400;
      color: var(--text-primary);
      margin-bottom: 8px;
      line-height: 1.2;
    }

    .updated {
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 48px;
    }

    h2 {
      font-family: 'Lora', serif;
      font-size: 18px;
      font-weight: 500;
      color: var(--accent);
      margin-top: 40px;
      margin-bottom: 12px;
    }

    p {
      color: var(--text-primary);
      margin-bottom: 16px;
      opacity: 0.9;
    }

    ul {
      margin: 0 0 16px 0;
      padding-left: 20px;
    }

    li {
      color: var(--text-primary);
      opacity: 0.9;
      margin-bottom: 8px;
    }

    li strong {
      color: var(--text-primary);
      opacity: 1;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      opacity: 0.9;
    }
    a:hover { opacity: 1; text-decoration: underline; }

    hr {
      border: none;
      border-top: 1px solid #2A2723;
      margin: 48px 0;
    }

    .footer {
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 48px;
    }
